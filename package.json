{
  "name": "wealthiher-theme",
  "version": "1.0.0",
  "description": "A custom WordPress theme for the WealthiHer Network website",
  "private": true,
  "scripts": {
    "build:block-editor": "wp-scripts build --config-name=block-editor --mode=production",
    "start:block-editor": "wp-scripts start --config-name=block-editor --mode=development",
    "build:theme": "webpack build --config-name=theme --mode=production",
    "start:theme": "webpack start --config-name=theme --mode=development"
  },
  "author": "Sweet Digital",
  "license": "UNLICENSED",
  "devDependencies": {
    "@splidejs/splide": "^4.1.3",
    "@wordpress/block-editor": "^10.1.0",
    "@wordpress/blocks": "^11.17.0",
    "@wordpress/i18n": "^4.22.0",
    "@wordpress/scripts": "24.4.0",
    "autoprefixer": "^10.4.7",
    "concurrent": "^0.3.2",
    "webpack": "^5.80.0",
    "webpack-cli": "^5.0.2",
    "webpack-log": "^3.0.2"
  }
}
